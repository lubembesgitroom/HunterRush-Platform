{
  "name": "@hunterrush/game-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",

  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },

  "files": [
    "dist"
  ],

  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "tsx src/test.ts",
    "test:timer": "tsx src/timer.test.ts",
    "test:multiplier": "tsx src/multiplier.test.ts",
    "test:loop": "tsx src/loop.test.ts",
    "test:clock": "tsx src/clock.test.ts",
    "test:phase": "tsx src/phase.test.ts"
  },

  "dependencies": {
    "@hunterrush/provably-fair": "workspace:*"
  },

  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2",
    "rimraf": "^6.0.1"
  }
}